<Page x:Class="AppKeyPass.Pages.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AppKeyPass.Pages"
      mc:Ignorable="d"
      Title="Register">

    <Grid>
        <StackPanel Width="200" Height="Auto" VerticalAlignment="Center">
            <Label Content="Логин:" Height="25"/>
            <TextBox x:Name="tbLogin" Height="25"/>
            <Label Content="Пароль:" Height="25"/>
            <PasswordBox x:Name="tbPassword" Height="25"/>
            <Label Content="Повторите пароль:" Height="25"/>
            <PasswordBox x:Name="tbPasswordConfirm" Height="25"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Click="BtnBack" Content="Назад" Height="25" Width="60" Margin="0,0,5,0"/>
                <Button Click="BtnRegister" Content="Создать" Height="25" Width="60"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
